{
  "name": "relayjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "relayjs: a trusted-peer registry for versioned artifacts using the Pear ecosystem",
  "bin": {
    "relay": "./dist/bin/relay.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test test/*.test.js",
    "prepare": "bun run build",
    "relay": "node dist/bin/relay.js"
  },
  "dependencies": {
    "corestore": "^7.12.4",
    "hypercore-crypto": "^3.7.0",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.1"
  },
  "devDependencies": {
    "@hyperswarm/testnet": "^3.1.4",
    "@types/node": "^22.20.1",
    "streamx": "^2.28.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "README.md",
    "docs",
    "decisions"
  ],
  "packageManager": "bun@1.3.14"
}
